# AAPA Configuration Example
# Copy this file to .env and configure your preferences.
# Sensitive secrets are never committed or logged.

# Local Loopback IPC Service
AAPA_HOST=127.0.0.1
AAPA_PORT=49152

# AI Provider Configuration ('rule_based', 'openai', 'gemini')
AAPA_AI_PROVIDER=rule_based
AAPA_AI_BASE_URL=http://localhost:11434/v1
AAPA_AI_MODEL=llama3
AAPA_AI_API_KEY=

# Application UI Preferences
AAPA_THEME=dark
AAPA_LOG_LEVEL=INFO
